#!/bin/bash
#SBATCH --job-name=lab3_period
#SBATCH --time=00:05:00
#SBATCH --mem=16G
#SBATCH --ntasks=17            ### 4x4 grid + 1 base station
#SBATCH --cpus-per-task=1
#SBATCH --ntasks-per-node=16
#SBATCH --output=period_test.%j.out
#SBATCH --partition=defq

module load openmpi/4.1.5-gcc-11.2.0-ux65npg

mpicc task1.c -o task1 -fopenmp

bash period_test.sh
