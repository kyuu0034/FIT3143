#!/bin/bash
#SBATCH --job-name=lab3_grid
#SBATCH --time=00:09:00        ### CAAS maximum is 10 minutes per job
#SBATCH --mem=16G
#SBATCH --ntasks=32            ### 32 is the maximum per job on CAAS
#SBATCH --cpus-per-task=1
#SBATCH --ntasks-per-node=16   ### 16 cores per compute node
#SBATCH --output=sweep_grid.%j.out
#SBATCH --partition=defq

module load openmpi/4.1.5-gcc-11.2.0-ux65npg

mpicc task1.c             -o task1   -fopenmp
mpicc task1_nonblocking.c -o task1nb -fopenmp

REPEATS=1 bash sweep.sh grid
